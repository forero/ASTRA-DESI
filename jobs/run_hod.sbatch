#!/bin/bash
#SBATCH --job-name=astra-hod
#SBATCH --account=desi
#SBATCH -q regular
#SBATCH -C cpu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --mem=0
#SBATCH --time=06:00:00
#SBATCH --output=slurm-hod-%A_%a.out
#SBATCH --error=slurm-hod-%A_%a.err
#SBATCH --chdir=/global/homes/v/vtorresg/ASTRA-DESI

set -euo pipefail

module load python/3.12

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

INPUT_ROOT=${INPUT_ROOT:-/pscratch/sd/n/ntbfin/emulator/hods/z0.5/yuan23_prior}
OUTPUT_ROOT=${OUTPUT_ROOT:?Set OUTPUT_ROOT to the HOD ASTRA result root}
MANIFEST=${MANIFEST:?Set MANIFEST to the file generated by build_hod_manifest.py}
N_ITERATIONS=${N_ITERATIONS:-5}
ITER_WORKERS=${ITER_WORKERS:-${SLURM_CPUS_PER_TASK}}
R_LOWER=${R_LOWER:--0.25}
R_MED=${R_MED:-0.25}
R_UPPER=${R_UPPER:-0.65}
TASK_OFFSET=${TASK_OFFSET:-0}
TASK_INDEX=$((TASK_OFFSET + SLURM_ARRAY_TASK_ID))

srun --ntasks=1 --cpus-per-task="${SLURM_CPUS_PER_TASK}" --cpu-bind=cores \
  python src/run_hod.py \
    --input-root "${INPUT_ROOT}" \
    --output-root "${OUTPUT_ROOT}" \
    --manifest "${MANIFEST}" \
    --task-index "${TASK_INDEX}" \
    --n-iterations "${N_ITERATIONS}" \
    --iteration-workers "${ITER_WORKERS}" \
    --r-lower "${R_LOWER}" \
    --r-med "${R_MED}" \
    --r-upper "${R_UPPER}"
